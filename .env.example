# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real credentials.

# Copernicus Data Space Ecosystem (OAuth2 client credentials)
# Generate at: https://shapps.dataspace.copernicus.eu/dashboard/#/account/settings
CDSE_CLIENT_ID=[]
CDSE_CLIENT_SECRET=[]

# Google Earth Engine (Cloud project ID, registered for non-commercial use)
EE_PROJECT_ID= project-12-502021

# Open-Meteo needs no key — left here only for documentation purposes.
